rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Pomocná funkce: anonymní přihlášení (zákaznický portál)
    function isAnonymous() {
      return request.auth != null
          && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    // Přihlášený ne-anonymní uživatel (mechanik, majitel)
    function signedIn() {
      return request.auth != null && !isAnonymous();
    }

    // ── Přihlášení uživatelé (mechanici, majitelé) ────────────────────────
    // Čtení všeho; zápis všude KROMĚ server-only kolekcí.
    // {col} = název kořenové kolekce, {document=**} = zbytek cesty (vč. podkolekcí).
    //
    // Server-only kolekce (zápis pouze přes Cloud Functions — Admin SDK obchází
    // pravidla): vynucení limitů by šlo obejít, kdyby si klient mohl sám
    // přepsat počítadlo nebo nasypat do cache. Proto:
    //   • pouziti      — měsíční počítadlo VIN/value (zdroj pravdy pro limity)
    //   • vin_cache    — cache VIN dekódování
    //   • value_cache  — cache tržní hodnoty
    match /{col}/{document=**} {
      allow read: if signedIn();
      allow write: if signedIn()
                   && !(col in ['pouziti', 'vin_cache', 'value_cache']);
    }

    // ── Zákaznický portál (anonymní přihlášení) ───────────────────────────
    // Anonymní uživatel smí číst POUZE:
    //   • zakázku, která má vyplněný portal_token (tj. byla přijata po aktualizaci)
    //   • zprávy zákazníka patřící k dané zakázce
    // Žádná jiná kolekce (zákazníci, sklad, faktury, nastavení…) není přístupná.

    match /zakazky/{docId} {
      allow read: if isAnonymous()
                  && resource.data.portal_token != null;

      match /zakaznik_zpravy/{msgId} {
        allow read: if isAnonymous();
        // Zákazník smí přidávat pouze vlastní zprávy (from_zakaznik musí být true)
        allow create: if isAnonymous()
                      && request.resource.data.from_zakaznik == true
                      && request.resource.data.keys().hasAll(['text', 'cas', 'autor', 'from_zakaznik']);
        // Zákazník smí pouze schválit nebo zamítnout nacenění
        allow update: if isAnonymous()
                      && resource.data.typ == 'naceneni'
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stav_schvaleni'])
                      && request.resource.data.stav_schvaleni in ['schvaleno', 'zamitnuto'];
      }
    }

  }
}

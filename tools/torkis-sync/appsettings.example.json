{
  // Identifikátor dealera v Torkisu — stejné servis_id, pod kterým appka
  // čte data ve Firestore. POVINNÉ a u každého dealera jiné.
  "ServisId": "ZDE_SERVIS_ID_DEALERA",

  "Sql": {
    // Connection string k ERP databázi na MS SQL Serveru u dealera.
    // Doporučeno Windows auth (Integrated Security) — bez hesla v souboru:
    //   "Server=SQLSERVER\\ERP;Database=ERP;Integrated Security=true;TrustServerCertificate=true;"
    // Nebo SQL login:
    //   "Server=...;Database=ERP;User Id=torkis;Password=...;TrustServerCertificate=true;"
    "ConnectionString": "Server=localhost;Database=ERP;Integrated Security=true;TrustServerCertificate=true;",

    // Dotaz MUSÍ vracet sloupec 'erp_id' (primární klíč z ERP) — z něj se
    // dělá stabilní ID dokumentu. Ostatní sloupce se uloží do Firestore 1:1,
    // takže je pojmenuj (aliasy) přesně tak, jak je čte appka:
    //   vozidla:   spz, vin, znacka, model, rok_vyroby, motorizace,
    //              palivo, prevodovka, tachometr, stk_mesic, stk_rok, zakaznik_id
    "VozidlaQuery": "SELECT v.Id AS erp_id, v.SPZ AS spz, v.VIN AS vin, v.Znacka AS znacka, v.Model AS model, v.RokVyroby AS rok_vyroby, v.Motorizace AS motorizace, v.IdZakaznika AS zakaznik_id FROM dbo.Vozidla v",

    //   zakaznici: jmeno, telefon, email, adresa, ico, dic, id_zakaznika
    "ZakazniciQuery": "SELECT z.Id AS erp_id, z.Id AS id_zakaznika, z.Nazev AS jmeno, z.Telefon AS telefon, z.Email AS email, z.Adresa AS adresa, z.ICO AS ico, z.DIC AS dic FROM dbo.Zakaznici z"
  },

  "Firebase": {
    // ID Firestore projektu Torkis (stejné pro všechny dealery).
    "ProjectId": "torkis-XXXXX",
    // Cesta k service account klíči. Relativní cesta se bere vůči tomuto souboru.
    "ServiceAccountPath": "service-account.json"
  },

  // true = po importu smaže z Firestore ERP záznamy, které už v ERP nejsou.
  "DeleteStale": true
}
